{
  "schemaVersion": 2,
  "name": "Working With Your Topic",
  "folder": "training-your-topic",
  "repoUrl": "https://github.com/databankimx/training-your-topic.git",
  "branch": "main",
  "baseDirectory": "C:\\Development\\training",
  "runTests": true,
  "installs": {
    "git": {
      "install": true,
      "winget": "Git.Git"
    },
    "powershell7": {
      "install": true,
      "pinned": "7",
      "winget": "Microsoft.PowerShell"
    },
    "node": {
      "install": true,
      "pinned": "24",
      "orNewer": true,
      "winget": "OpenJS.NodeJS.LTS"
    },
    "python": {
      "install": false,
      "pinned": "3.12",
      "sideBySide": true,
      "winget": "Python.Python.3.12"
    },
    "dotnet": {
      "install": false,
      "pinned": "10",
      "winget": "Microsoft.DotNet.SDK.10"
    },
    "jdk": {
      "install": false,
      "pinned": "25",
      "winget": "EclipseAdoptium.Temurin.25.JDK"
    },
    "maven": {
      "install": false,
      "pinned": "3.10.0",
      "root": "C:\\Tools",
      "url": "https://repo1.maven.org/maven2/org/apache/maven/apache-maven/3.10.0/apache-maven-3.10.0-bin.zip"
    },
    "rust": {
      "install": false,
      "winget": "Rustlang.Rustup"
    },
    "msys2": {
      "install": false,
      "root": "C:\\msys64",
      "packages": []
    },
    "visualStudio": {
      "install": false,
      "pinned": "17",
      "workloads": [
        "Microsoft.VisualStudio.Workload.ManagedDesktop"
      ]
    },
    "vcRuntime": {
      "install": true
    },
    "vscode": {
      "install": true,
      "winget": "Microsoft.VisualStudioCode",
      "extensions": []
    },
    "notepadPlusPlus": {
      "install": true,
      "winget": "Notepad++.Notepad++"
    },
    "buildTools": {
      "install": false
    }
  },
  "steps": [
    {
      "name": "npm packages",
      "type": "npm",
      "folder": ".",
      "command": "ci",
      "requires": [
        "node"
      ]
    },
    {
      "name": "Course tests",
      "type": "npm-run",
      "folder": ".",
      "script": "test",
      "runTests": true,
      "requires": [
        "node"
      ]
    }
  ],
  "launch": {
    "ide": "vscode",
    "kind": "electron",
    "folder": "lesson-runner"
  }
}
